# Уведомление о новом заказе в Telegram.
#
# Без этих двух переменных сайт работает: заявка проходит проверку, покупатель
# получает номер, а сама заявка пишется в лог сервера. Но продавец её не увидит,
# поэтому перед запуском их надо заполнить.
#
# Как получить:
#   1. Создать бота у @BotFather → он выдаст токен.
#   2. Написать боту любое сообщение из чата, куда должны падать заказы.
#   3. Открыть https://api.telegram.org/bot<ТОКЕН>/getUpdates и взять оттуда
#      chat.id. Для группы он отрицательный — минус тоже часть значения.
#
# Скопировать этот файл в .env.local и подставить свои значения.

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# Расчёт доставки СДЭК (API v2).
#
# Без ключей форма показывает фиксированный тариф из
# content/pages/delivery.json и работает как раньше — расчёт просто
# не подключается. С ключами цена и срок приходят из СДЭК по городу.
#
# Учётные данные выдают в личном кабинете СДЭК после заключения договора.
# Для проверки без договора у СДЭК есть тестовый контур: адрес и тестовые
# ключи опубликованы в их документации, подставьте их сюда и раскомментируйте
# CDEK_API_URL.

CDEK_ACCOUNT=
CDEK_SECURE_PASSWORD=

# Тестовый контур СДЭК. На бою строку оставить закомментированной —
# по умолчанию используется https://api.cdek.ru/v2
# CDEK_API_URL=https://api.edu.cdek.ru/v2

# Город отправления, из которого считается тариф.
CDEK_FROM_CITY=Москва


# Яндекс.Метрика — номер счётчика.
#
# Без него счётчик не подключается вовсе: в браузер не уходит ни байта
# стороннего кода, а полоса про cookie не показывается. Цели настраивать
# в интерфейсе Метрики как «JavaScript-событие» с такими идентификаторами:
#
#   add-to-cart     положили товар в корзину
#   checkout-open   открыли оформление с непустой корзиной
#   order-done      заказ принят (главная цель)
#   picker-used     ответили на вопрос подбора модели
#   video-play      запустили промо-ролик
#   lead-sent       отправили анкету «остались вопросы»
#
# Переменная публичная: её значение попадает в код страницы, это нормально —
# номер счётчика и так виден всем.

NEXT_PUBLIC_METRIKA_ID=
